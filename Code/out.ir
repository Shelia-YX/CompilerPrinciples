FUNCTION add :
PARAM v1
t4 := v1
t2 := *t4
t5 := v1
t6 := t5 + #4
t3 := *t6
t1 := t2 + t3
RETURN t1
FUNCTION main :
DEC v3 8
t7 := &v3
*t7 := #0
t8 := t7 + #4
*t8 := #0
t9 := #1
t10 := &v3
*t10 := t9
t11 := #2
t12 := &v3
t13 := t12 + #4
*t13 := t11
t15 := &v3
ARG t15
t14 := CALL add
v2 := t14
t16 := v2
WRITE t16
t17 := #0
RETURN t17
